all_names(x = "X0...11", allow_suspicious = TRUE) # TRUE

# modified by make.names(x, unique = TRUE) or by vctrs::vec_as_names()
all_names(x = c(".if...4", "a...2")) # FALSE
all_names(x = c(".if...4", "a...2"), allow_suspicious = TRUE) # TRUE

